Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "Pi"}], 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"theta10", "[", "x", "]"}], ",", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"theta10", "[", "x", "]"}], "-", 
          RowBox[{"theta10", "[", 
           RowBox[{"0.5", "x"}], " ", "]"}]}], ")"}]}], "}"}]}], "//", 
     "Evaluate"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"10", "^", 
       RowBox[{"(", 
        RowBox[{"-", "7"}], ")"}]}], ",", "30"}], "}"}], ",", 
