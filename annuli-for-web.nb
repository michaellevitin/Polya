Cell[CellGroupData[{

Cell["\<\
\[Section]5.  Bounds on the phase functions difference and reduction to a \
lattice counting problem\
\>", "Section",
 CellChangeTimes->{{3.932291150417321*^9, 3.932291157839172*^9}, 
   3.947068723292152*^9, {3.955950796922772*^9, 3.955950807237269*^9}, {
   3.955950884551622*^9, 
   3.955950887407905*^9}},ExpressionUUID->"925ed14b-e5fa-4b01-9320-\
c5a0bccff80c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"G", "[", 
    RowBox[{"\[Lambda]_", ",", "z_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{
     SqrtBox[
      RowBox[{
       SuperscriptBox["\[Lambda]", "2"], "-", 
       SuperscriptBox["z", "2"]}]], "-", 
     RowBox[{"z", " ", 
      RowBox[{"ArcCos", "[", 
       FractionBox["z", "\[Lambda]"], "]"}]}]}], "\[Pi]"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"H", "[", 
    RowBox[{"\[Lambda]_", ",", "z_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"3", 
       RowBox[{"\[Lambda]", "^", "2"}]}], "+", 
      RowBox[{"2", 
       RowBox[{"z", "^", "2"}]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"24", "Pi", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Lambda]", "^", "2"}], "-", 
         RowBox[{"z", "^", "2"}]}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"3", "/", "2"}], ")"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"H1", "[", 
    RowBox[{"\[Lambda]_", ",", "z_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"3", 
       RowBox[{"\[Lambda]", "^", "2"}]}], "+", 
      RowBox[{"2", 
       RowBox[{"\[Lambda]", "^", "2"}]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"24", "Pi", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Lambda]", "^", "2"}], "-", 
         RowBox[{"z", "^", "2"}]}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"3", "/", "2"}], ")"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"F", "[", 
    RowBox[{"\[Lambda]_", ",", "z_"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"z", "<", "\[Lambda]"}], ",", 
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"G", "[", 
         RowBox[{"\[Lambda]", ",", "z"}], "]"}], "-", 
        RowBox[{"H", "[", 
         RowBox[{"\[Lambda]", ",", "z"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"-", "1"}], "/", "4"}]}], "]"}], ",", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "4"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalPhi]", "[", 
    RowBox[{"\[Lambda]_", ",", "\[Mu]_", ",", "z_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"G", "[", 
     RowBox[{"\[Lambda]", ",", "z"}], "]"}], "-", 
    RowBox[{"G", "[", 
     RowBox[{"\[Mu]", ",", "z"}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.932621618402666*^9, 3.932621623599955*^9}, {
   3.9470688511066723`*^9, 3.9470689384140882`*^9}, 3.948731251804923*^9, {
   3.94873130249441*^9, 3.948731352022902*^9}},
 CellLabel->
  "In[264]:=",ExpressionUUID->"466357fb-192a-4a22-a468-66c4c344bbaa"],

