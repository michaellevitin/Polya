Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"OneBlock", "[", 
    RowBox[{
    "\[Lambda]0_", ",", " ", "\[Mu]0_", ",", "\[Lambda]1_", ",", " ", 
     "\[Alpha]_", ",", " ", 
