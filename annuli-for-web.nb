Cell["Figure 6", "Item",
 CellChangeTimes->{{3.947069901332658*^9, 3.9470699035929127`*^9}, {
  3.948684154231679*^9, 3.9486841544832783`*^9}, {3.955950899908114*^9, 
  3.955950900246814*^9}},ExpressionUUID->"e392ea0c-ad51-4ded-a9fc-\
b7ceee18f08d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Lambda]0", "=", "20"}], ";", " ", 
   RowBox[{"\[Mu]0", "=", "12"}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"interse", "=", 
   RowBox[{
    RowBox[{"NSolveValues", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"G", "[", 
           RowBox[{"\[Mu]0", ",", "z"}], "]"}], "-", 
          RowBox[{"H", "[", " ", 
           RowBox[{"\[Mu]0", ",", "z"}], "]"}], "+", 
          RowBox[{"1", "/", "4"}]}], "==", "0"}], ",", " ", 
        RowBox[{
         RowBox[{"\[Mu]0", "/", "2"}], "<=", "z", "<=", " ", "\[Mu]0"}]}], 
       "}"}], ",", " ", "z"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"interse1", "=", 
   RowBox[{
    RowBox[{"NSolveValues", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"G", "[", 
           RowBox[{
            RowBox[{"\[Mu]0", "-", "1"}], ",", "z"}], "]"}], "-", 
          RowBox[{"H", "[", " ", 
           RowBox[{
            RowBox[{"\[Mu]0", "-", "1"}], ",", "z"}], "]"}], "+", 
          RowBox[{"1", "/", "4"}]}], "==", "0"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Mu]0", "/", "2"}], "-", 
