be2a02961927"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"CosUp", "[", "x_", "]"}], ":=", 
   RowBox[{"1", "-", 
    FractionBox[
     SuperscriptBox["x", "2"], "2"], "+", 
    FractionBox[
     SuperscriptBox["x", "4"], "24"], "-", 
    FractionBox[
     SuperscriptBox["x", "6"], "720"], "+", 
    FractionBox[
     SuperscriptBox["x", "8"], "40320"], "-", 
    FractionBox[
     SuperscriptBox["x", "10"], "3628800"], "+", 
    FractionBox[
     SuperscriptBox["x", "12"], "479001600"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CosDown", "[", "x_", "]"}], ":=", 
   RowBox[{"1", "-", 
    FractionBox[
     SuperscriptBox["x", "2"], "2"], "+", 
    FractionBox[
     SuperscriptBox["x", "4"], "24"], "-", 
    FractionBox[
     SuperscriptBox["x", "6"], "720"], "+", 
    FractionBox[
     SuperscriptBox["x", "8"], "40320"], "-", 
    FractionBox[
     SuperscriptBox["x", "10"], "3628800"], "+", 
    FractionBox[
     SuperscriptBox["x", "12"], "479001600"], "-", 
    FractionBox[
     SuperscriptBox["x", "14"], "87178291200"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"VerifiedQUpArcCos", "[", 
    RowBox[{"x_", ",", "\[Epsilon]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ac0", ",", "ac"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ac0", "=", 
       RowBox[{"ArcCos", "[", "x", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"MatchQ", "[", 
          RowBox[{"ac0", ",", "_Rational"}], "]"}], "||", " ", 
         RowBox[{"IntegerQ", "[", "ac0", "]"}]}], ",", " ", 
        RowBox[{"ac", "=", "ac0"}], ",", " ", "\[IndentingNewLine]", " ", 
        RowBox[{
         RowBox[{"ac", "=", 
          RowBox[{"Rationalize", "[", 
           RowBox[{
            RowBox[{"ac0", "+", 
             RowBox[{"2", "\[Epsilon]"}]}], ",", "\[Epsilon]"}], "]"}]}], ";", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"CosUp", "[", "ac", "]"}], ">=", "x"}], ",", " ", 
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"VerifiedQUpArcCos", "::", "Error"}], ",", " ", "x"}], 
            "]"}], ",", " ", "ac"}], "]"}]}]}], "]"}], ";", " ", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"ac", "=", 
         RowBox[{"Rationalize", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ArcCos", "[", "x", "]"}], "+", 
            RowBox[{"2", "\[Epsilon]"}]}], ",", "\[Epsilon]"}], "]"}]}], 
        ";"}], " ", "*)"}], "\[IndentingNewLine]", "ac"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"VerifiedQUpArcCos", "::", "Error"}], 
   "=", "\"\<ArcCosUp of argument `1` is wrong!\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"VerifiedQDownArcCos", "[", 
    RowBox[{"x_", ",", "\[Epsilon]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ac0", ",", " ", "ac"}], "}"}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{
      RowBox[{"ac0", "=", 
       RowBox[{"ArcCos", "[", "x", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"MatchQ", "[", 
          RowBox[{"ac0", ",", "_Rational"}], "]"}], "||", " ", 
         RowBox[{"IntegerQ", "[", "ac0", "]"}]}], ",", " ", 
        RowBox[{"ac", "=", "ac0"}], ",", " ", "\[IndentingNewLine]", " ", 
        RowBox[{
         RowBox[{"ac", "=", 
          RowBox[{"Rationalize", "[", 
           RowBox[{
            RowBox[{"ac0", "-", 
             RowBox[{"2", "\[Epsilon]"}]}], ",", "\[Epsilon]"}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"CosDown", "[", "ac", "]"}], "<=", "x"}], ",", " ", 
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"VerifiedQDownArcCos", "::", "Error"}], ",", " ", "x"}], 
            "]"}], ",", " ", "ac"}], "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", "ac"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"VerifiedQDownArcCos", "::", "Error"}], 
   "=", "\"\<ArcCosDown of argument `1` is wrong!\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"VerifiedQUpSqrt", "[", 
    RowBox[{"x_", ",", "\[Epsilon]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ac0", ",", " ", "ac"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ac0", "=", 
       RowBox[{"Sqrt", "[", "x", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"MatchQ", "[", 
          RowBox[{"ac0", ",", "_Rational"}], "]"}], "||", " ", 
         RowBox[{"IntegerQ", "[", "ac0", "]"}]}], ",", " ", 
        RowBox[{"ac", "=", "ac0"}], ",", " ", "\[IndentingNewLine]", " ", 
        RowBox[{
         RowBox[{"ac", "=", 
          RowBox[{"Rationalize", "[", 
           RowBox[{
            RowBox[{"ac0", "+", 
             RowBox[{"2", "\[Epsilon]"}]}], ",", "\[Epsilon]"}], "]"}]}], ";",
          "  ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ac", "^", "2"}], "<", "x"}], ",", " ", 
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"VerifiedQUpSqrt", "::", "Error"}], ",", " ", "x"}], 
            "]"}], ",", " ", "ac"}], "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", "ac"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
