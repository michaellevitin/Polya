Cell[CellGroupData[{

Cell["\<\
Numerically computed phase functions and their differences (in case needed; \
not in the paper)\
\>", "Item",
 CellChangeTimes->{{3.9486369398834877`*^9, 3.94863694702983*^9}, {
  3.9487349524405327`*^9, 3.948734961919529*^9}, {3.955697188077619*^9, 
  3.955697192029998*^9}, {3.955950840534389*^9, 3.9559508497458363`*^9}, {
  3.956378805478739*^9, 
  3.9563788136362123`*^9}},ExpressionUUID->"3c570007-ca54-4c96-bb43-\
92a9dda65ccd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sntheta\[Nu]", "[", 
   RowBox[{"\[Nu]_", ",", "X_"}], "]"}], ":=", 
  RowBox[{"theta", "/.", 
   RowBox[{
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"theta", "'"}], "[", "x", "]"}], "==", 
         RowBox[{"2", "/", 
          RowBox[{"(", 
           RowBox[{"Pi", " ", "x", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"BesselJ", "[", 
                RowBox[{"\[Nu]", ",", "x"}], "]"}], "^", "2"}], " ", "+", 
              RowBox[{
               RowBox[{"BesselY", "[", 
                RowBox[{"\[Nu]", ",", "x"}], "]"}], "^", "2"}]}], ")"}]}], 
           ")"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{"theta", "[", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "7"}], ")"}]}], "]"}], "==", 
         RowBox[{
          RowBox[{"-", "Pi"}], "/", "2"}]}]}], "}"}], ",", " ", "theta", ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"10", "^", 
         RowBox[{"(", 
          RowBox[{"-", "7"}], ")"}]}], ",", "X"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9486369592501287`*^9, 3.948636978485361*^9}, {
  3.9486845058151007`*^9, 3.948684515086795*^9}},
 CellLabel->
  "In[428]:=",ExpressionUUID->"07700c1a-fab2-48fb-be9c-a8a743693e1a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"theta10", "=", 
   RowBox[{"sntheta\[Nu]", "[", 
    RowBox[{"10", ",", "50"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.951205199209675*^9, 3.951205204920732*^9}, {
  3.951205240921219*^9, 3.951205272350616*^9}, {3.9512053044614477`*^9, 
  3.951205305835167*^9}, {3.951205345988318*^9, 3.951205374510748*^9}, {
