981b1d8ff84e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Tau]hash", "[", "d_", "]"}], ":=", 
   RowBox[{
    SuperscriptBox["2", 
     RowBox[{"1", "/", "3"}]], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", "d"}], ")"}], 
     FractionBox["1", 
      RowBox[{"3", "d"}]]], 
    RowBox[{
     SuperscriptBox[
      RowBox[{"Gamma", "[", 
       RowBox[{"1", "+", 
        FractionBox["d", "2"]}], "]"}], 
      RowBox[{"2", "/", 
       RowBox[{"(", 
        RowBox[{"3", "d"}], ")"}]}]], "/", 
     RowBox[{"Sqrt", "[", "d", "]"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.998791264400928*^9, 3.998791405256172*^9}, {
  3.998875080958701*^9, 3.99887508461931*^9}},
 CellLabel->"In[98]:=",ExpressionUUID->"071502cd-fbf8-49a4-a93b-b5d76c106d74"],

