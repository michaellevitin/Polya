5335688eee2f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"h30", "=", 
   RowBox[{
    RowBox[{"Limit", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"h", "'''"}], "[", "t", "]"}], ",", " ", 
      RowBox[{"t", "->", "0"}], ",", " ", 
      RowBox[{"Direction", "->", "\"\<FromAbove\>\""}]}], "]"}], "//", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h11", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"h", "'"}], "[", "1", "]"}], "//", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h21", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"h", "''"}], "[", "1", "]"}], "//", "Simplify"}]}], 
  ";"}]}], "Input",
