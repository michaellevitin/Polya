Cell["General definitions", "Item",
 CellChangeTimes->{{3.998793007236168*^9, 
  3.998793012213492*^9}},ExpressionUUID->"c2b75bb6-3e03-4195-bc72-\
f1ecbd46662b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Iis", "[", 
    RowBox[{"\[Rho]_", ",", "d_"}], "]"}], ":=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"\[Rho]", ",", "x"}], "]"}], "^", "2"}], " ", 
        RowBox[{"x", "^", 
         RowBox[{"(", 
          RowBox[{"d", "-", "1"}], ")"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"d", ">=", "3"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Rho]", "^", "2"}], " ", 
        RowBox[{"x", "^", 
         RowBox[{"(", 
          RowBox[{"d", "-", "3"}], ")"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"d", ">=", "3"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Rho]", "^", "2"}], " ", 
        RowBox[{"x", "^", 
         RowBox[{"(", 
          RowBox[{"d", "-", "1"}], ")"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"d", ">=", "3"}]}]}], "]"}]}], "\[IndentingNewLine]", "}"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FdOfTau", "[", 
    RowBox[{"d_", ",", " ", "Iif_", ",", " ", "\[Tau]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"X", ",", "k", ",", "\[Lambda]", ",", "Iid"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Iid", "=", 
       RowBox[{
        RowBox[{"Iif", "[", "d", "]"}], "//", "Evaluate"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"X", " ", "=", " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"\[Lambda]", "^", "2"}], " ", 
              RowBox[{"Iid", "[", 
               RowBox[{"[", "3", "]"}], "]"}]}], "-", 
             RowBox[{"Iid", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", 
           RowBox[{"Iid", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"d", "/", "2"}], "-", "1"}], ")"}], "^", "2"}]}], "]"}], 
        "-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"d", "/", "2"}], "-", "1"}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"2", "Pi"}], "]"}], 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"1", "/", 
           RowBox[{"(", 
            RowBox[{"4", "d"}], ")"}]}]}], ")"}], " ", 
        RowBox[{"d", "^", 
         RowBox[{"(", 
          RowBox[{"3", "/", "2"}], ")"}]}], 
        RowBox[{"(", 
         RowBox[{"X", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"d", "-", "3"}], ")"}], "/", "2"}]}], ")"}], 
        RowBox[{
         RowBox[{"Product", "[", 
          RowBox[{
           RowBox[{"X", "+", "k"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", 
             RowBox[{"d", "-", "3"}]}], "}"}]}], "]"}], "/", 
         RowBox[{"\[Lambda]", "^", "d"}]}]}], "/.", 
       RowBox[{"\[Lambda]", "->", 
        RowBox[{
         RowBox[{"\[Tau]", "^", "3"}], 
         RowBox[{"d", "^", 
          RowBox[{"(", 
           RowBox[{"3", "/", "2"}], ")"}]}]}]}]}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.998793024995414*^9, 3.998793034490801*^9}, {
  3.998793067510498*^9, 3.998793076347584*^9}, {3.998793166448722*^9, 
  3.998793167327924*^9}},
 CellLabel->"In[43]:=",ExpressionUUID->"ef8fbd87-ef51-448b-8ea9-b5a305c51570"]
}, Open  ]]
}, Open  ]],

