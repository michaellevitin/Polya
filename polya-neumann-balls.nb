Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Sqrt", "[", "2", "]"}], "t"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Pi", "/", "2"}], "-", 
       RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], 
     RowBox[{"t", "^", "3"}]}], "-", 
    RowBox[{"ArcCos", "[", 
     RowBox[{"1", "-", 
      RowBox[{"t", "^", "2"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"figphi", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"h", "[", "t", "]"}], ",", 
      RowBox[{
       RowBox[{"h", "'"}], "[", "t", "]"}], ",", 
      RowBox[{
       RowBox[{"h", "''"}], "[", "t", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0.001", ",", "1"}], "}"}], ",", 
    RowBox[{"PlotRange", "->", "0.06"}], ",", " ", 
    RowBox[{"PlotStyle", "->", "Thick"}], ",", " ", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"MaTeX", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<h(t)\>\"", ",", "\"\<h'(t)\>\"", ",", "\"\<h''(t)\>\""}], 
       "}"}], "]"}]}], ",", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"MaTeX", "[", "\"\<t\>\"", "]"}], ",", "None"}], "}"}]}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.998891937988195*^9, 3.99889193919837*^9}, 
   3.998891989621627*^9},
