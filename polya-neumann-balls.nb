Cell["A single dimension, reproducing one row of Table 1", "Subsection",
 CellChangeTimes->{{3.998903574076364*^9, 
  3.998903591509041*^9}},ExpressionUUID->"3599c6d7-3fd5-4846-85af-\
14aa043abb4d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"listP", " ", "=", " ", 
    RowBox[{"ComputeListP", "[", 
     RowBox[{"3", ",", " ", "19", ",", " ", 
      RowBox[{"1", "/", "100"}]}], "]"}]}], ";"}], "      ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"d", " ", "=", " ", "3"}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Lambda", "^"}], "*", "_", "3"}], " ", "=", " ", "19"}]}], "  ",
    "*)"}]}], "\n", 
 RowBox[{"     ", 
  RowBox[{"Length", "[", "listP", "]"}], 
  "                                                    ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"K_", "3"}], " ", "=", " ", "50"}], "                ", 
   "*)"}]}], "\n", 
 RowBox[{"     ", 
  RowBox[{"NeumannCountingFunction", "[", 
   RowBox[{"listP", ",", " ", "3"}], "]"}], "      ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"N", "^", "Neu"}], " ", "=", " ", "570"}], "             ", 
   "*)"}]}], "\n", 
 RowBox[{"     ", 
  RowBox[{"PolyaRatio", "[", 
   RowBox[{"3", ",", " ", 
    RowBox[{"ExpandListP", "[", 
     RowBox[{"3", ",", " ", "listP"}], "]"}]}], "]"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"exact", ";", " ", 
    RowBox[{"approx", " ", "0.9061"}]}], "  ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"     ", 
  RowBox[{"Dataset", "[", 
   RowBox[{
    RowBox[{"ExpandListP", "[", 
     RowBox[{"3", ",", " ", "listP"}], "]"}], ",", 
    RowBox[{"ItemDisplayFunction", "->", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Identity", "[", "#", "]"}], "&"}], ")"}]}]}], "]"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{"the", " ", "expanded", " ", "list"}], "       ", 
   "*)"}]}]}], "Input",
 CellChangeTimes->{{3.998903615890032*^9, 3.998903704511938*^9}, {
