Cell[CellGroupData[{

Cell["Definitions from Proposition 3.5", "Item",
 CellChangeTimes->{{3.998566979176343*^9, 
  3.998566984751832*^9}},ExpressionUUID->"b59014ee-09a0-40e1-8134-\
2abf36ea271f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Omega]", "=", 
   FractionBox[
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"3", " ", "\[Pi]"}], ")"}], 
     RowBox[{"2", "/", "3"}]], 
    RowBox[{"4", " ", 
     SuperscriptBox["2", 
      RowBox[{"1", "/", "3"}]]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    SubscriptBox["T", "3"], "[", 
    RowBox[{"d_", ",", "\[Tau]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"Pi", "/", "8"}], "]"}], 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox["\[Omega]", 
       SuperscriptBox["\[Tau]", "2"]]}]], " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "6"}], "+", "d"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "2"}], "+", "d"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "d"}], ")"}]}], 
       RowBox[{"24", " ", "d", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"d", " ", 
            SuperscriptBox["\[Tau]", "3"]}], "-", 
           RowBox[{"\[Tau]", " ", "\[Omega]"}]}], ")"}], "2"]}]], "-", 
      FractionBox[
       RowBox[{"d", "-", "1"}], 
       RowBox[{"2", " ", 
        SqrtBox["d"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"d", " ", 
           SuperscriptBox["\[Tau]", "3"]}], "-", 
          RowBox[{"\[Tau]", " ", "\[Omega]"}]}], ")"}]}]]}], ")"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.998567723162497*^9, 3.998567730848881*^9}, {
  3.998567870495042*^9, 3.998567878140457*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"63bf27df-cdf1-4613-a834-6d15a9dadfc3"]
}, Open  ]],

