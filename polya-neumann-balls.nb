Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["t", 
      RowBox[{"1", ",", "0"}]], "[", "d_", "]"}], ":=", 
    FractionBox[
     RowBox[{"1", "+", 
      RowBox[{"8", " ", "d"}], "+", 
      RowBox[{"32", " ", 
       SuperscriptBox["d", "2"]}]}], 
     RowBox[{"64", " ", 
      SuperscriptBox["d", 
       RowBox[{"5", "/", "2"}]]}]]}], ";", 
   RowBox[{
    RowBox[{
     SubscriptBox["t", 
      RowBox[{"1", ",", "3"}]], "[", "d_", "]"}], ":=", 
    FractionBox[
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"d", "<=", "6"}], ",", "0", ",", 
       RowBox[{
        RowBox[{"-", "6"}], "+", "d"}]}], "]"}], 
     RowBox[{"(", 
      RowBox[{"6", "+", 
       RowBox[{"24", " ", "d"}]}], ")"}]]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    SubscriptBox["T", "1"], "[", 
    RowBox[{"d_", ",", "\[Tau]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     SubscriptBox["t", 
      RowBox[{"1", ",", "0"}]], "[", "d", "]"}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["t", 
       RowBox[{"1", ",", "3"}]], "[", "d", "]"}], 
     RowBox[{"\[Tau]", "^", 
      RowBox[{"(", 
       RowBox[{"-", "3"}], ")"}]}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.998564888918852*^9, 3.998564909986393*^9}, {
  3.998564948260242*^9, 3.998564954929578*^9}, {3.9985650116906424`*^9, 
