Cell[CellGroupData[{

Cell["The enclosures for the RHS of (C.21), using (C.18)", "Item",
 CellChangeTimes->{{3.998899931873959*^9, 3.9988999473535767`*^9}, {
  3.998900159152604*^9, 
  3.998900171407485*^9}},ExpressionUUID->"4346750e-13d2-4fe4-b02f-\
9aaa68dd8615"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"tildeQbullet", "[", 
    RowBox[{"d_", ",", "\[Tau]_"}], "]"}], ":=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"5", "d", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"d", "-", "2"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"5", 
          RowBox[{"d", "^", "2"}]}], "-", 
         RowBox[{"6", "d"}], "-", "4"}], ")"}]}]}], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"5", " ", 
        RowBox[{"(", 
         RowBox[{"d", "-", "2"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"d", "+", "8"}], ")"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"8", " ", "d", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"5", " ", 
           RowBox[{"d", "^", "2"}]}], "-", 
          RowBox[{"6", " ", "d"}], "-", "4"}], ")"}], 
        RowBox[{"\[Tau]", "^", "6"}]}], ")"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RHSC21", "[", 
    RowBox[{"d_", ",", "\[Tau]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"193", "/", "77"}], " ", 
    RowBox[{"\[Tau]", "^", 
     RowBox[{"(", 
      RowBox[{"-", "3"}], ")"}]}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "2"}], 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"d", "-", "1"}], ")"}], "^", "2"}], "/", 
       RowBox[{"(", 
        RowBox[{"5", "d", 
         RowBox[{"(", 
          RowBox[{"d", "-", "2"}], ")"}]}], ")"}]}]}], "]"}], 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"d", "-", "1"}], ")"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"d", "+", "8"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"8", 
            RowBox[{"d", "^", "2"}], " ", 
            RowBox[{"\[Tau]", "^", "6"}]}], "-", "d", "-", "8"}], ")"}]}], 
        ")"}]}]}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"2", 
         RowBox[{"\[Tau]", "^", "3"}], " ", 
         RowBox[{"Sqrt", "[", "d", "]"}], " ", 
         RowBox[{"tildeQbullet", "[", 
          RowBox[{"d", ",", "\[Tau]"}], "]"}]}], ")"}]}], "-", " ", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"24", " ", 
         RowBox[{"\[Tau]", "^", "6"}], " ", 
         RowBox[{
          RowBox[{"tildeQbullet", "[", 
           RowBox[{"d", ",", "\[Tau]"}], "]"}], "^", "2"}]}], ")"}]}]}], 
     ")"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{
