   "ObjectType" -> "Symbol", "Usage" -> 
    "\!\(\*RowBox[{\"CenteredInterval\", \"[\", RowBox[{StyleBox[\"x\", \
\"TI\"], \",\", StyleBox[\"dx\", \"TI\"]}], \"]\"}]\) for real numbers \
\!\(\*StyleBox[\"x\", \"TI\"]\) and \!\(\*StyleBox[\"dx\", \"TI\"]\) gives a \
centered interval that contains the real interval \!\(\*RowBox[{\"{\", \
RowBox[{RowBox[{\"a\", \"\[Element]\", StyleBox[\"\[DoubleStruckCapitalR]\", \
ShowSyntaxStyles -> False, FontFamily -> \"Times\"]}], \"|\", \
RowBox[{RowBox[{\"x\", \"-\", StyleBox[\"dx\", \"TI\"]}], \"\[LessEqual]\", \
\"a\", \"\[LessEqual]\", RowBox[{\"x\", \"+\", StyleBox[\"dx\", \
\"TI\"]}]}]}], \"}\"}]\).\n\!\(\*RowBox[{\"CenteredInterval\", \"[\", \
RowBox[{RowBox[{StyleBox[\"x\", \"TI\"], \"+\", RowBox[{\"\[ImaginaryI]\", \" \
\", StyleBox[\"y\", \"TI\"]}]}], \",\", RowBox[{StyleBox[\"dx\", \"TI\"], \"+\
\", RowBox[{\"\[ImaginaryI]\", \" \", StyleBox[\"dy\", \"TI\"]}]}]}], \"]\"}]\
\) gives a centered interval that contains the complex rectangle \
\!\(\*RowBox[{\"{\", RowBox[{RowBox[{RowBox[{\"a\", \"+\", RowBox[{\"\
\[ImaginaryI]\", \" \", \"b\"}]}], \"\[Element]\", StyleBox[\"\
\[DoubleStruckCapitalC]\", ShowSyntaxStyles -> False, FontFamily -> \
\"Times\"]}], \"|\", RowBox[{RowBox[{RowBox[{\"x\", \"-\", StyleBox[\"dx\", \
\"TI\"]}], \"\[LessEqual]\", \"a\", \"\[LessEqual]\", RowBox[{\"x\", \"+\", \
StyleBox[\"dx\", \"TI\"]}]}], \"\[And]\", RowBox[{RowBox[{\"y\", \"-\", \
StyleBox[\"dy\", \"TI\"]}], \"\[LessEqual]\", \"b\", \"\[LessEqual]\", \
RowBox[{\"y\", \"+\", StyleBox[\"dy\", \"TI\"]}]}]}]}], \"}\"}]\).\n\
\!\(\*RowBox[{\"CenteredInterval\", \"[\", StyleBox[\"c\", \"TI\"], \"]\"}]\) \
for an approximate number \!\(\*StyleBox[\"c\", \"TI\"]\) gives a centered \
interval that contains all values within the error bounds of \
\!\(\*StyleBox[\"c\", \"TI\"]\).", 
