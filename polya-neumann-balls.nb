Cell[CellGroupData[{

Cell["\[Section]4.5. Alternative test function ", "Subsection",
 CellChangeTimes->{{3.998831256624222*^9, 
  3.998831272507059*^9}},ExpressionUUID->"bfed9eae-e13b-4737-8e83-\
c8104678330c"],

Cell[CellGroupData[{

Cell["Integrals", "Item",
 CellChangeTimes->{{3.998831356137546*^9, 
  3.998831358246512*^9}},ExpressionUUID->"c32f9b54-feb5-4604-b699-\
d52555c5dd1b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]Alt", "[", 
    RowBox[{"d_", ",", "x_"}], "]"}], ":=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"0", "<=", "x", "<=", 
         RowBox[{"1", "-", 
          RowBox[{"2", "/", "d"}]}]}]}], "}"}], "}"}], ",", 
     RowBox[{
      RowBox[{"x", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "d"}], ")"}], "/", "2"}], ")"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", "-", "1", "+", 
         RowBox[{"2", "/", "d"}]}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"3", "/", "2"}], ")"}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"IiAlt", "=", 
  RowBox[{
   RowBox[{"Iis", "[", 
    RowBox[{
     RowBox[{"\[Rho]Alt", "[", 
      RowBox[{"d", ",", "x"}], "]"}], ",", "d"}], "]"}], "//", 
   "Simplify"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"IiAltf", "[", "d_", "]"}], ":=", 
   RowBox[{"Evaluate", "[", "IiAlt", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.998831365278344*^9, 3.998831388657106*^9}},
 CellLabel->"In[52]:=",ExpressionUUID->"06533316-e82a-498e-a6dd-725df722ea67"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", 
    FractionBox[
     RowBox[{"8", "-", 
      RowBox[{"88", " ", "d"}], "+", 
      RowBox[{"98", " ", 
       SuperscriptBox["d", "2"]}], "-", 
      RowBox[{"42", " ", 
       SuperscriptBox["d", "3"]}], "+", 
      RowBox[{"6", " ", 
       SuperscriptBox["d", "4"]}], "+", 
      RowBox[{"3", " ", 
