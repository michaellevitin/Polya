Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"1", "/", "Pi"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "-", 
        RowBox[{"x", "^", "2"}]}], "]"}], "-", 
      RowBox[{"x", " ", 
       RowBox[{"ArcCos", "[", "x", "]"}]}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"G", "[", 
    RowBox[{"\[Lambda]_", ",", " ", "z_"}], "]"}], ":=", 
   RowBox[{"\[Lambda]", " ", 
    RowBox[{"h", "[", 
     RowBox[{"z", "/", "\[Lambda]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Wdisk", "[", 
    RowBox[{"d_", ",", "\[Lambda]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Lambda]", "/", "2"}], ")"}], "^", "d"}], " ", 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"1", "+", 
       RowBox[{"d", "/", "2"}]}], "]"}], "^", 
     RowBox[{"(", 
      RowBox[{"-", "2"}], ")"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.880181796747164*^9, {3.8801818370624857`*^9, 3.880181853883666*^9}, {
   3.880182393653049*^9, 3.8801823941606827`*^9}, {3.909069360759796*^9, 
   3.909069361321045*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"d22799aa-b05d-404d-9af6-05787fdd7076"]
}, Open  ]],

