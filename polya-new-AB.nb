      RowBox[{"1", "/", "2"}], ",", "\[Epsilon]"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GQDown", "[", 
    RowBox[{"\[Lambda]_", ",", " ", "z_", ",", " ", "\[Epsilon]_"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"z", ">", "\[Lambda]"}], ",", "0", ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"VerifiedQDownSqrt", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Lambda]", "^", "2"}], "-", 
           RowBox[{"z", "^", "2"}]}], ",", " ", "\[Epsilon]"}], "]"}], "-", 
        RowBox[{"z", " ", 
         RowBox[{"VerifiedQUpArcCos", "[", 
          RowBox[{
           RowBox[{"z", "/", "\[Lambda]"}], ",", " ", "\[Epsilon]"}], 
          "]"}]}]}], ")"}], "/", 
      RowBox[{"PiUp", "[", "\[Epsilon]", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"WdiskQUp", "[", 
    RowBox[{"d_", ",", " ", "\[Lambda]_", ",", "\[Epsilon]_"}], " ", "]"}], ":=", 
   RowBox[{
    RowBox[{"Wdisk", "[", 
     RowBox[{"d", ",", "\[Lambda]"}], "]"}], "/.", 
    RowBox[{"Pi", "->", 
     RowBox[{"PiDown", "[", "\[Epsilon]", "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"adisk", "[", 
    RowBox[{"d_", ",", "\[Epsilon]_"}], "]"}], ":=", 
