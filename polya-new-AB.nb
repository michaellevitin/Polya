Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"StepCheckAB", "[", 
    RowBox[{"\[Lambda]_", ",", " ", "\[Epsilon]_"}], "]"}], ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"e", ",", " ", "\[Lambda]new"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"e", "=", 
       RowBox[{
        RowBox[{"PABNeuQDown", "[", 
         RowBox[{"\[Lambda]", ",", " ", "\[Epsilon]"}], "]"}], "-", 
        RowBox[{"WdiskQUp", "[", 
         RowBox[{"2", ",", " ", "\[Lambda]", ",", "\[Epsilon]"}], "]"}]}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"e", "<=", "0"}], ",", " ", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Process stopped with e=\>\"", ",", "e"}], "]"}], ";", 
         RowBox[{"Return", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"\[Lambda]new", "=", " ", 
       RowBox[{"VerifiedQDownRoot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Lambda]", "^", "2"}], "+", 
          RowBox[{"e", "/", 
           RowBox[{"adisk", "[", 
            RowBox[{"2", ",", "\[Epsilon]"}], "]"}]}]}], ",", "2", ",", 
         "\[Epsilon]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"\[Lambda]", ",", 
        RowBox[{"\[Lambda]", "//", "N"}], ",", " ", "e", ",", 
        RowBox[{"e", "//", "N"}], ",", " ", "\[Lambda]new", ",", "  ", 
        RowBox[{"\[Lambda]new", "//", "N"}]}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RunChecksAB", "[", 
    RowBox[{
    "\[CapitalLambda]start_", ",", " ", "\[CapitalLambda]end_", ",", 
     "\[Epsilon]_", ",", "printstep_"}], "]"}], ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[CapitalLambda]", ",", " ", "nI", ",", " ", "data", ",", "step"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"data", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"nI", "=", "1"}], ";", " ", "\[IndentingNewLine]", 
      RowBox[{"\[CapitalLambda]", "=", "\[CapitalLambda]start"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"step", "=", 
          RowBox[{"StepCheckAB", "[", 
           RowBox[{"\[CapitalLambda]", ",", " ", "\[Epsilon]"}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{"printstep", ",", 
