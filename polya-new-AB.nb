Cell[TextData[{
 "This script accompanies the paper ",
 StyleBox["Inequalities \[AGrave] la P\[OAcute]lya for the \
Aharonov\[LongDash]\[NoBreak]Bohm eigenvalues of the disk",
  FontSlant->"Italic"],
 " by N.\[NonBreakingSpace]Filonov, M.\[NonBreakingSpace]Levitin, I.\
\[NonBreakingSpace]Polterovich, and \
D.\[NonBreakingSpace]A.\[NonBreakingSpace]Sher, see Proposition 3.8 "
}], "Title",
 CellChangeTimes->{{3.909318947697052*^9, 3.909319060276492*^9}, {
  3.909319131028561*^9, 3.909319151273552*^9}, {3.909319246890115*^9, 
