 RowBox[{
  RowBox[{
   RowBox[{"PABNeuQDown", "[", 
    RowBox[{"\[Lambda]_", ",", " ", "\[Epsilon]_"}], "]"}], ":=", 
   RowBox[{"Total", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Floor", "[", 
        RowBox[{
         RowBox[{"GQDown", "[", 
          RowBox[{"\[Lambda]", ",", " ", 
           RowBox[{"m", "+", 
            RowBox[{"1", "/", "2"}]}], ",", " ", "\[Epsilon]"}], "]"}], "+", 
         RowBox[{"3", "/", "4"}]}], "]"}], "+", 
       RowBox[{"Floor", "[", 
        RowBox[{
         RowBox[{"GQDown", "[", 
          RowBox[{"\[Lambda]", ",", " ", 
           RowBox[{"m", "+", "1"}], ",", " ", "\[Epsilon]"}], "]"}], "+", 
         RowBox[{"3", "/", "4"}]}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"m", ",", "0", ",", 
