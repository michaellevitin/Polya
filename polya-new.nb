  RowBox[{
   RowBox[{"h", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"1", "/", "Pi"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "-", 
        RowBox[{"x", "^", "2"}]}], "]"}], "-", 
      RowBox[{"x", " ", 
       RowBox[{"ArcCos", "[", "x", "]"}]}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"G", "[", 
    RowBox[{"\[Lambda]_", ",", " ", "z_"}], "]"}], ":=", 
   RowBox[{"\[Lambda]", " ", 
    RowBox[{"h", "[", 
     RowBox[{"z", "/", "\[Lambda]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Wdisk", "[", 
    RowBox[{"d_", ",", "\[Lambda]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Lambda]", "/", "2"}], ")"}], "^", "d"}], " ", 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"1", "+", 
       RowBox[{"d", "/", "2"}]}], "]"}], "^", 
     RowBox[{"(", 
      RowBox[{"-", "2"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Kappa]", "[", 
    RowBox[{"d_", ",", "m_"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"m", "==", "0"}], ",", "1", ",", 
     RowBox[{
      RowBox[{"Binomial", "[", 
       RowBox[{
        RowBox[{"m", "+", "d", "-", "1"}], ",", 
        RowBox[{"d", "-", "1"}]}], "]"}], "-", 
      RowBox[{"Binomial", "[", 
       RowBox[{
        RowBox[{"m", "+", "d", "-", "3"}], ",", 
        RowBox[{"d", "-", "1"}]}], "]"}]}]}], "]"}]}], ";"}]}], "Input",
